@@ -0,0 +1,12 @@
+/// Server expiration is exclusive; display the last usable minute in Korea.
+DateTime? lastPassMinute(DateTime? expiration) => expiration
+    ?.toUtc()
+    .subtract(const Duration(milliseconds: 1))
+    .add(const Duration(hours: 9));
+
+String passDeadlineText(DateTime expiration) {
+  final lastMinute = lastPassMinute(expiration)!;
+  return '${lastMinute.month}/${lastMinute.day} '
+      '${lastMinute.hour.toString().padLeft(2, '0')}:'
+      '${lastMinute.minute.toString().padLeft(2, '0')}';
+}
