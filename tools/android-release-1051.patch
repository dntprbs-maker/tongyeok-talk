+++ b/test/pass_deadline_test.dart
@@ -0,0 +1,13 @@
+import 'package:bridgechat/pass_deadline.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('exclusive midnight stays on the previous Korea calendar day', () {
+    expect(passDeadlineText(DateTime.utc(2026, 11, 21, 15)), '11/21 23:59');
+    expect(passDeadlineText(DateTime.utc(2026, 12, 31, 15)), '12/31 23:59');
+  });
+  test('an actual non-midnight expiration keeps its final usable minute', () {
+    expect(passDeadlineText(DateTime.utc(2026, 11, 20, 4, 30)), '11/20 13:29');
+    expect(lastPassMinute(null), isNull);
+  });
+}
