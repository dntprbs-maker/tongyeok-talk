rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function member(cid) { return signed() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants; }
  // Public username directory only. Email and passwords stay in Firebase Auth.
  match /users/{uid} {
   allow read: if true;
   allow create: if signed() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['username','preferredLanguage','createdAt'])
    && request.resource.data.username is string && request.resource.data.username.size() > 0 && request.resource.data.username.size() <= 40
    && request.resource.data.preferredLanguage is string && request.resource.data.preferredLanguage.size() <= 40
    && request.resource.data.createdAt == request.time;
   allow update: if signed() && request.auth.uid == uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferredLanguage'])
    && request.resource.data.preferredLanguage is string && request.resource.data.preferredLanguage.size() <= 40;
  }
  match /conversations/{cid} {
   allow read: if signed() && request.auth.uid in resource.data.participants;
   allow create: if signed() && request.resource.data.keys().hasOnly(['participants','isGroup','groupName','lastMessage','timestamp'])
    && request.resource.data.participants is list && request.auth.uid in request.resource.data.participants
    && request.resource.data.participants.size() >= 2 && request.resource.data.participants.size() <= 11
    && request.resource.data.participants.toSet().size() == request.resource.data.participants.size()
    && request.resource.data.lastMessage == '' && request.resource.data.timestamp == request.time;
   allow update: if member(cid)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','timestamp','groupName'])
    && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 2000
    && (!request.resource.data.keys().hasAny(['groupName']) || (request.resource.data.groupName is string && request.resource.data.groupName.size() <= 100));
   match /messages/{mid} {
    allow read: if member(cid);
    allow create: if member(cid)
     && request.resource.data.keys().hasOnly(['senderId','originalText','translations','timestamp','sourceLang'])
     && request.resource.data.senderId == request.auth.uid
     && request.resource.data.originalText is string && request.resource.data.originalText.size() > 0 && request.resource.data.originalText.size() <= 2000
     && request.resource.data.translations is map && request.resource.data.translations.size() == 0
     && request.resource.data.timestamp == request.time && request.resource.data.sourceLang is string;
   }
  }
 }
}
