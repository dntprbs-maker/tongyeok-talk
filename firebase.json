{
  "functions": [{"source": "functions-mobile-auth", "codebase": "mobile-auth"}],
  "hosting": {
    "site": "tongyeok-talk-lab-20261024",
    "public": "hosting",
    "headers": [
      {"source": "/mobile/**", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/guest", "headers": [
        {"key": "Cache-Control", "value": "no-cache"},
        {"key": "Referrer-Policy", "value": "no-referrer"}
      ]}
    ],
    "rewrites": [
      {"source": "/i", "destination": "/friend-invite.html"},
      {"source": "/review-auth", "function": {"functionId": "mobileAuthExchange", "region": "asia-northeast3"}},
      {"source": "/sessions", "function": {"functionId": "rewardApi", "region": "asia-northeast3"}},
      {"source": "/guest", "destination": "/guest-entry.html"},
      {"source": "/referrals/**", "function": {"functionId": "rewardApi", "region": "asia-northeast3"}},
      {"source": "/guest-api/**", "function": {"functionId": "rewardApi", "region": "asia-northeast3"}}
    ],
    "redirects": [{"source": "/", "destination": "https://dntprbs-maker.github.io/tongyeok-talk/", "type": 302}]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
