<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Local reward verification through adb reverse; release keeps HTTPS only. -->
    <application android:usesCleartextTraffic="true"
        android:label="통역톡 개발판"
        android:icon="@mipmap/ic_launcher_development"
        tools:replace="android:label,android:icon">
        <!-- Google's official sample application for developer test ads only. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" tools:replace="android:value"/>
    </application>
</manifest>
